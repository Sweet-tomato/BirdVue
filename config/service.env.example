# 复制为 config/service.env 后填入真实值，并执行 chmod 600
OPENAI_API_KEY1=
OPENAI_BASE_URL1=https://ark.cn-beijing.volces.com/api/v3
OPENAI_VLM_MODEL1=doubao-seed-2-0-lite-260428
DOUBAO_REASONING_EFFORT=minimal
# 采样温度，默认 0（留空则不传 temperature 参数）
DOUBAO_TEMPERATURE=0
DOUBAO_MAX_OUTPUT_TOKENS=2048

BIRD_WORKERS=1
BIRD_HOST=0.0.0.0
BIRD_PORT=8000

# 并发推理上限：BioCLIP 编码可并发，OpenCV 检测仍串行；默认 4
BIRD_MODEL_CONCURRENCY=4
# 结果查询最长等待秒数，默认 15；未完成即返回当前状态，调用方继续轮询或用 callbackUrl
BIRD_RESULT_LONGPOLL_SECONDS=15

# 留空 = 不鉴权；生产必须设置，调用方使用 Authorization: Bearer <token>
BIRD_API_KEY=

# 豆包复核开关：0 = 仅本地模型输出（Top5 + 性状子句），不调用豆包
BIRD_REVIEW_ENABLED=1

# 听音识鸟：独立服务，与图片识别完全分离；1 = 允许启动，0 = 关闭
BIRD_AUDIO_ENABLED=1
BIRD_AUDIO_HOST=0.0.0.0
BIRD_AUDIO_PORT=8001
BIRD_AUDIO_CONCURRENCY=2
# 单条音频大小上限（字节），默认 20MB
BIRD_MAX_AUDIO_BYTES=20971520

# 图片与结果落盘：0 = 处理完即删
BIRD_PERSIST_ENABLED=1
BIRD_RETENTION_DAYS=30
BIRD_LOG_DIR=logs
BIRD_LOG_RETENTION_DAYS=30

# 可选回调推送：提交时带 callbackUrl 即启用
BIRD_CALLBACK_SECRET=
BIRD_CALLBACK_MAX_ATTEMPTS=3
BIRD_CALLBACK_TIMEOUT_SECONDS=10
# 内网回调地址默认被 SSRF 防护拦截，确需内网回调时置 1
BIRD_CALLBACK_ALLOW_PRIVATE=0
